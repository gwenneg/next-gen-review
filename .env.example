# Copy to .env and fill in. Never commit .env.

# Any value. Only the api and the database get it.
POSTGRES_PASSWORD=change-me

# A fine-grained GitHub token with read-only access to public repositories. Only the api gets it.
# GH_TOKEN works too, like with the gh CLI. If both are set, GH_TOKEN wins, and a GH_TOKEN or
# GITHUB_TOKEN exported in your shell wins over this file. The page shows which variable was used.
# Create it at https://github.com/settings/personal-access-tokens/new: under "Repository access",
# pick "Public repositories". No permissions are needed.
GITHUB_TOKEN=

# Optional: a GitHub token that can write PR reviews, to post a review's comments from the page.
# Only the api gets it, and only to post. A classic token with the public_repo scope works on every
# public repo. A fine-grained token only works on the repos it's given "Pull requests: Read and write"
# on. The reviews are posted as this token's user. Leave it empty to keep posting off.
GH_REVIEW_TOKEN=

# From `claude setup-token` on your laptop. Only the worker gets it.
CLAUDE_CODE_OAUTH_TOKEN=
